{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v-quicksell",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // "/" must hit the Worker so it can set the auth cookie; assets are served
  // before the Worker by default, which silently skipped it.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/"] },

  "d1_databases": [
    { "binding": "DB", "database_name": "quicksell", "database_id": "83fdb7a2-3905-4c18-9fb1-185e4d9a7ff8" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "205eb9712486470fb7d69dfb17adb7d1" }
  ],
  "images": { "binding": "IMAGES" },

  "triggers": { "crons": ["* * * * *", "0 9 * * *"] },

  "vars": {
    "VINTED_HOST": "www.vinted.it",
    "LOCALE": "it",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "CURRENCY": "EUR",
    "BUMP_PCT": 50,
    "DROP_PCT": 5,
    "DROP_EVERY_DAYS": 3,
    "APP_VERSION": "1.0.0",
    "APK_VERSION": "1.0.0",
    "PUBLIC_URL": "https://v-quicksell.neurone00.workers.dev",
    "VAPID_PUBLIC": "BEJJOG4gqZcBfQ774L-lycB5q-dP63GY0zLQljQi62g4ktg840ASHTqW22yJxESMRO7sIVFkvHNee6zlPQpVtqI"
  }
}

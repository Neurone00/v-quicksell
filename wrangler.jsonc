{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v-quicksell",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": { "directory": "./public", "binding": "ASSETS" },

  "d1_databases": [
    { "binding": "DB", "database_name": "quicksell", "database_id": "ba02d758-9b16-4428-820c-f8c6370cd62a" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "9862cd81e327490882bda2d5fdc773ef" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "quicksell-photos" }
  ],
  "browser": { "binding": "BROWSER" },
  "images": { "binding": "IMAGES" },

  "triggers": { "crons": ["0 9 * * *"] },

  "vars": {
    "VINTED_HOST": "www.vinted.it",
    "LOCALE": "it",
    "CURRENCY": "EUR",
    "BUMP_PCT": 50,
    "DROP_PCT": 5,
    "DROP_EVERY_DAYS": 3,
    "APP_VERSION": "1.0.0",
    "APK_VERSION": "1.0.0",
    "PUBLIC_URL": "https://v-quicksell.l-salvioni.workers.dev",
    "VAPID_PUBLIC": "BEJJOG4gqZcBfQ774L-lycB5q-dP63GY0zLQljQi62g4ktg840ASHTqW22yJxESMRO7sIVFkvHNee6zlPQpVtqI"
  }
}
